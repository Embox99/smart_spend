# --- required ---
MONGO_URI=mongodb://localhost:27017/smart_spend
JWT_SECRET=your_super_secret_key_here

# --- optional ---
# Comma-separated list of origins allowed to call the API
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Token lifetime
JWT_EXPIRES_IN=7d

# Public base URL used to build uploaded-image links.
# Set this when the API sits behind a proxy or CDN.
PUBLIC_URL=http://localhost:5000

# Set to 1 when deployed behind a reverse proxy so rate limiting
# sees the real client IP instead of the proxy's.
TRUST_PROXY=
